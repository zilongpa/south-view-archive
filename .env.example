ARCHIVE_DATA_MODE=local
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
BETTER_AUTH_URL=http://127.0.0.1:3000
# local: persistent PGlite + private attachments; fixture: read-only; database: PostgreSQL.
# SOUTHVIEW_DATA_DIR=.southview
PHOTO_STORAGE=local
# Optional staff-only historical vetting with GPT-6 Luna + web search.
# OPENAI_API_KEY= # Server only; never expose as NEXT_PUBLIC_ or commit a real key.
# See docs/AI-VETTING.md. Without a key, manual review remains available.
# Deployed authentication needs a random secret of at least 32 bytes and an HTTPS origin.
# BETTER_AUTH_SECRET=
# Optional Google sign-in: create a dedicated Google Cloud Web application OAuth client.
# Local redirect URI: http://127.0.0.1:3000/api/auth/callback/google
# Production redirect URI: exact HTTPS BETTER_AUTH_URL + /api/auth/callback/google
# Server-only values; never prefix with NEXT_PUBLIC_ or commit credentials. See docs/GOOGLE-AUTH.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The archive sends no email: contributors keep their private receipt link, and Google is the only account sign-in.
# Photos: S3-compatible storage, configured for Cloudflare R2. See docs/R2-STORAGE.md.
# Keep both originals and processed images private; disable r2.dev and public custom domains.
# Deployed: a private Vercel Blob store connected to the project (see docs/VERCEL-BLOB-STORAGE.md).
# PHOTO_STORAGE=vercel-blob
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# Or Cloudflare R2 / another S3-compatible store:
# PHOTO_STORAGE=s3
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=south-view-archive
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_SESSION_TOKEN= # Optional for other S3 providers; not needed for R2 API token credentials.
# Existing Supabase Storage deployments may still explicitly use PHOTO_STORAGE=supabase
# with SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and SUPABASE_PRIVATE_BUCKET.
# TRUST_PROXY=1 only behind a trusted proxy which replaces X-Forwarded-For.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_FONT=Noto Sans Regular
# NEXT_PUBLIC_MAP_ATTRIBUTION is optional; built-in style attribution is always retained.
# For database mode, set ARCHIVE_DATA_MODE=database and provide your server-only URI.
# DATABASE_URL=postgresql://...
# MIGRATION_DATABASE_URL=postgresql://...
