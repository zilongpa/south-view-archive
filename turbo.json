{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "OPENAI_API_KEY",
    "ARCHIVE_DATA_MODE",
    "ARCHIVE_LOCAL_PATH",
    "SOUTHVIEW_DATA_DIR",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_PRIVATE_BUCKET",
    "PHOTO_STORAGE",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_FORCE_PATH_STYLE",
    "S3_SESSION_TOKEN",
    "TRUST_PROXY",
    "DATABASE_URL",
    "MIGRATION_DATABASE_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_MAP_STYLE_URL",
    "NEXT_PUBLIC_MAP_ATTRIBUTION",
    "NEXT_PUBLIC_MAP_FONT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "public/vendor/maplibre/**"]
    },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "dev": { "cache": false, "persistent": true }
  }
}
